<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.andrewmcdonald.blink-status</string>
    <key>ProgramArguments</key>
    <array><string>__SUPPORT_DIR__/bin/blink-statusd</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardOutPath</key><string>__LOG_DIR__/stdout.log</string>
    <key>StandardErrorPath</key><string>__LOG_DIR__/stderr.log</string>
    <key>Umask</key><integer>63</integer>
</dict>
</plist>
